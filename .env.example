# No default model, endpoint or API key. Set these explicitly.
AI_PROVIDER=cloud
AI_BASE_URL=
# OpenAI Chat base URL: https://api.openai.com/v1
AI_MODEL=gpt-6.1-terra
AI_API_KEY=
# Explicit protocol: compatibility mode sends no OpenAI-only parameters.
AI_PROTOCOL=chat-compatible
# json_schema is strict; json_object only requests JSON syntax. No automatic fallback.
AI_RESPONSE_FORMAT=json_object
# OpenAI mode: explicitly set AI_PROTOCOL=openai-chat and AI_RESPONSE_FORMAT=json_schema.
# Choose a model and budget first. Optional reasoning (model-dependent):
# AI_REASONING_EFFORT=high
# Required explicit output cap for openai-chat; includes reasoning + visible tokens:
# AI_MAX_COMPLETION_TOKENS=<chosen integer 1-128000>
# local: set AI_PROVIDER=local, e.g. a running OpenAI-compatible local server.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=<installed-model-name>
# AI_API_KEY is optional only for AI_PROVIDER=local.
AI_TIMEOUT_MS=120000
# Legacy only if AI_RESPONSE_FORMAT is absent: AI_JSON_MODE=true/false.
# Optional: path to UTF-8 verified consultation reference text.
# CQA_REFERENCE_FILE=
# Optional human-assigned source version; otherwise a content-addressed SHA-256 version.
# CQA_REFERENCE_VERSION=
# Full signed dataset endpoint, server-only. group_id is supplied through the UI.
# CQA_DATASET_URL=
PORT=3000
# Bind to loopback behind an authenticated HTTPS proxy.
HOST=127.0.0.1
# CQA_PUBLIC_ORIGIN=https://your-app.example
# CQA_EMBED_ORIGINS=https://your-org.crm4.dynamics.com
# CQA_DATA_DIR=data
